{
  "annotations": {"list": []},
  "editable": true,
  "schemaVersion": 39,
  "title": "GoodVolunteer — Infrastructure & Pipeline",
  "uid": "gv-infra",
  "tags": ["goodvolunteer", "infra"],
  "time": {"from": "now-15m", "to": "now"},
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "API Request Rate (req/s by endpoint)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(flask_http_request_total[1m])) by (endpoint)", "legendFormat": "{{endpoint}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "API Latency p95 (s)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(flask_http_request_duration_seconds_bucket[5m])) by (le, endpoint))", "legendFormat": "p95 {{endpoint}}"}
      ]
    },
    {
      "type": "stat",
      "title": "Kafka Consumer Lag (total)",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [
        {"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 200}
      ]}}},
      "targets": [
        {"expr": "sum(kafka_consumergroup_lag{consumergroup=\"volunteer-consumers\"})", "legendFormat": "lag"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer Lag over time (by partition)",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "kafka_consumergroup_lag{consumergroup=\"volunteer-consumers\"}", "legendFormat": "partition {{partition}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Messages Produced vs Consumed (per s)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(kafka_publish_success_total[1m]))", "legendFormat": "produced"},
        {"expr": "sum(rate(consumer_events_processed_total[1m]))", "legendFormat": "consumed"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka Publish Failures (rate)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(kafka_publish_failures_total[1m])) by (event_type)", "legendFormat": "{{event_type}}"}
      ]
    },
    {
      "type": "stat",
      "title": "Duplicate Events Skipped (idempotency)",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "consumer_events_skipped_total", "legendFormat": "skipped"}
      ]
    },
    {
      "type": "stat",
      "title": "Kafka Broker Up",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "kafka_brokers", "legendFormat": "brokers"}
      ]
    }
  ]
}
